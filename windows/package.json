{
  "name": "mcpgo-windows",
  "version": "2.1.0-preview.1",
  "private": true,
  "description": "McpGo Windows desktop agent",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "ru.mcpgo.desktop",
    "productName": "McpGo",
    "directories": {
      "output": "../release/windows"
    },
    "files": [
      "app/*.cjs",
      "app/*.js",
      "app/*.html",
      "app/*.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../terminal",
        "to": "mcpgo-runtime/terminal",
        "filter": [
          "platform.js",
          "stateless_server.js",
          "job_runtime.js",
          "job_worker.js",
          "resource_locks.js",
          "resource_policy.js",
          "mcp-version.json",
          "server.js",
          "pty_worker_win.js",
          "stateful_bridge.cjs",
          "files_tools.cjs",
          "dashboard.html",
          "dashboard.js",
          "dashboard.css"
        ]
      },
      {
        "from": "../playwright",
        "to": "mcpgo-runtime/playwright",
        "filter": [
          "action-guard.mjs",
          "restricted-proxy.mjs"
        ]
      },
      {
        "from": "../playwright/node_modules",
        "to": "mcpgo-runtime/playwright/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../native/McpGoMark.png",
        "to": "mcpgo-runtime/native/McpGoMark.png"
      },
      {
        "from": "../autosend",
        "to": "mcpgo-runtime/autosend",
        "filter": [
          "*.mjs"
        ]
      },
      {
        "from": "../messaging",
        "to": "mcpgo-runtime/messaging",
        "filter": [
          "hub.py"
        ]
      },
      {
        "from": "../onboarding",
        "to": "mcpgo-runtime/onboarding",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "../windows/onboarding_cli.py",
        "to": "mcpgo-runtime/onboarding_cli.py"
      },
      {
        "from": "vendor/node",
        "to": "mcpgo-runtime/node"
      },
      {
        "from": "vendor/python",
        "to": "mcpgo-runtime/python"
      },
      {
        "from": "vendor/tunnel",
        "to": "mcpgo-runtime/tunnel"
      },
      {
        "from": "node_modules/@lydell",
        "to": "mcpgo-runtime/pty/node_modules/@lydell",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/mcpgo.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "McpGo"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  }
}
