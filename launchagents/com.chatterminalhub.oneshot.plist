<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.chatterminalhub.oneshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__</string>
		<string>__MCPGO_ROOT__/terminal/stateless_server.js</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/McpGo/com.chatterminalhub.oneshot.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/McpGo/com.chatterminalhub.oneshot.out.log</string>
	<key>WorkingDirectory</key>
	<string>__MCPGO_ROOT__/terminal</string>
</dict>
</plist>
